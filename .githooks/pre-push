#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit

root=$(git rev-parse --show-toplevel)
cd "${root}"
uv run --frozen python -B .github/lint/style_check.py
timeout 600 pwsh -NoProfile -File .github/lint/Invoke-PSLint.ps1
uv run --frozen ruff format --check .
uv run --frozen ruff check --ignore-noqa .
uv run --frozen pyright --warnings .github/lint lint/common lint/python/.github/lint
uv run --frozen python -I .github/lint/pystyle.py
npx --no-install tsc --noEmit
npx --no-install eslint . --max-warnings 0
npx --no-install prettier --check .
timeout 600 dotnet restore Workflows.slnx --locked-mode
timeout 600 dotnet format Workflows.slnx --verify-no-changes --no-restore
timeout 600 dotnet build Workflows.slnx -c Release --no-restore
timeout 600 dotnet test Workflows.slnx -c Release --no-build
timeout 600 dotnet run .github/lint/CSharpStyle.cs -- .
if [[ ${OSTYPE} == msys* || ${OSTYPE} == cygwin* ]]; then
  windows_root=$(pwd -W)
  MSYS_NO_PATHCONV=1 timeout 180 wsl --distribution "${LINT_WSL_DISTRO:?Set LINT_WSL_DISTRO to your lint distro}" \
    --cd "${windows_root}" -- bash .githooks/check-shell
else
  bash .githooks/check-shell
fi
timeout 600 pwsh -NoProfile -File .github/Invoke-Tests.ps1
timeout 180 uv run --frozen python -B -m unittest discover -s lint/common/tests -t .
cd lint/python/.github/lint
timeout 180 uv run --frozen python -B -m unittest discover -s selftest -t .
